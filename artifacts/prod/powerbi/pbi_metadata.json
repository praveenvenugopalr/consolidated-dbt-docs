          "name": "High Risk Accounts",
          "expression": "CALCULATE(\n\t\t\tCOUNTROWS('Dormancy Risk'),\n\t\t\t'Dormancy Risk'[dormancy_risk_category] IN {\"HIGH\", \"CRITICAL\"}\n\t\t)",
