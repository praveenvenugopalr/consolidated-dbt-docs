          "expression": "DIVIDE(\n\t\t\tCALCULATE(COUNTROWS('Customer 360'), 'Customer 360'[segment] = \"PREMIUM\"),\n\t\t\tCOUNTROWS('Customer 360'),\n\t\t\t0\n\t\t)",
