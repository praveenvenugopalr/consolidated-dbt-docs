        {
          "name": "Dormancy Rate %",
          "expression": "DIVIDE(\n\t\t\tCALCULATE(COUNTROWS('Dormancy Risk'), 'Dormancy Risk'[dormancy_risk_category] <> \"LOW\"),\n\t\t\tCOUNTROWS('Dormancy Risk'),\n\t\t\t0\n\t\t)",
